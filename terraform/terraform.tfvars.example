# Copy this to terraform.tfvars (gitignored — see ../.gitignore) and fill
# in real values. Never commit terraform.tfvars itself.

# Your current public IP, no /32 suffix. Get it yourself:
#   curl -4 ifconfig.me
# There's no default for this variable on purpose — see variables.tf.
my_ip = "203.0.113.42"

# Uncomment to override defaults (both already match most setups):
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# aws_region           = "eu-north-1"
# instance_type        = "t3.small"
