POSTGRES_USER=daraz
POSTGRES_PASSWORD=daraz
POSTGRES_DB=daraz_price_tracker

# asyncpg driver, host matches the "postgres" service name in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://daraz:daraz@postgres:5432/daraz_price_tracker

# host matches the "redis" service name in docker-compose.yml
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=scrape_jobs

LOG_LEVEL=INFO

# worker poll intervals (seconds) — see worker_app/main.py
DEQUEUE_TIMEOUT_SECONDS=5
PROMOTE_INTERVAL_SECONDS=2
GAUGE_REFRESH_INTERVAL_SECONDS=5

# minimum seconds the worker waits between scrape requests
POLITE_DELAY_SECONDS=3

# retry/backoff for failed scrape jobs (full jitter: actual delay is
# random.uniform(0, min(base * factor^(attempt-1), max_delay)))
RETRY_BASE_DELAY_SECONDS=5
RETRY_BACKOFF_FACTOR=2
RETRY_MAX_DELAY_SECONDS=600
RETRY_MAX_ATTEMPTS=5

# SMTP for AlertRule(channel="email"). Defaults point at the local Mailhog
# service — no real email needed for dev. For real delivery (e.g. Gmail),
# set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, and an
# app-password in SMTP_USERNAME/SMTP_PASSWORD.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
ALERT_FROM_EMAIL=alerts@daraz-price-tracker.local

# alert dedup — see shared/alerts.py's module docstring for the full strategy
ALERT_MATERIAL_CHANGE_PCT=5
ALERT_COOLDOWN_MINUTES=60

# Your real Discord webhook URL, for local testing only. NEVER commit a
# real value here — this is a live credential. Paste it into your own
# untracked .env, not this file.
DISCORD_WEBHOOK_URL=
