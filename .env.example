POSTGRES_USER=daraz
POSTGRES_PASSWORD=daraz
POSTGRES_DB=daraz_price_tracker

# asyncpg driver, host matches the "postgres" service name in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://daraz:daraz@postgres:5432/daraz_price_tracker

# host matches the "redis" service name in docker-compose.yml
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=scrape_jobs

# minimum seconds the worker waits between scrape requests
POLITE_DELAY_SECONDS=3
